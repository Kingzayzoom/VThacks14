# Copy this file to .env and fill in what you have. Everything works with no keys at all.

# --- Agent brains (Gemini) ---
# Get a free key at https://aistudio.google.com  → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto = Gemini if a key is set, else offline templates. Options: auto | gemini | offline
LLM_MODE=auto

# --- ANS ---
# sim = local ANS simulator (default). godaddy = GoDaddy's hosted ANS API.
ANS_BACKEND=sim
# Only for ANS_BACKEND=godaddy. Get a key at https://www.AgentNameRegistry.org
ANS_API_URL=
ANS_API_KEY=
ANS_API_SECRET=

# --- Demo ---
# Seconds of deliberate pause between steps so the audience can follow. 0 for fastest.
DEMO_PACE=1.0

# --- Deployment overrides (leave empty to run everything locally) ---
# HUB_URL=http://127.0.0.1:8000
# ANS_SIM_URL=http://127.0.0.1:8100
# AGENT_ENDPOINT_BRAND=https://agent.brandstudio.xyz
